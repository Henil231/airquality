# Copy to .env and fill in. gcp.sh reads these values.
PROJECT=your-gcp-project-id
REGION=us-central1
BUCKET=your-project-airquality
SQL_INSTANCE=air-sql
CLUSTER=air-demo
PGPASS=change-me

# JDBC url the cloud Spark jobs use to reach Cloud SQL. The cluster runs the
# Cloud SQL Auth Proxy (wired in gcp.sh up), so the host is localhost.
# Keep the password in sync with PGPASS.
PGURL=jdbc:postgresql://localhost:5432/air?user=postgres&password=change-me

# Data source API keys, all free. Optional locally: fetch.py falls back to
# synthetic readings so you can develop offline.
OPENAQ_KEY=
AIRNOW_KEY=
PURPLEAIR_KEY=
